# Optional overrides for Docker Compose (F360_LM_* avoids clashing with Enigma gateway env).
F360_LM_POSTGRES_PASSWORD=foundry360_dev_change_me
F360_LM_POSTGRES_PORT=15434
F360_LM_PORT=3085
F360_LM_SESSION_SECRET=change-me-to-a-long-random-string
F360_LM_SEED_ADMIN_PASSWORD=changeme-admin
F360_LM_SEED_VIEWER_PASSWORD=changeme-viewer

# Local Node.js development (npm run dev) — not used inside Compose for DATABASE_URL
DATABASE_URL=postgres://foundry360:foundry360_dev_change_me@127.0.0.1:15434/foundry360_licenses
PORT=3085
SESSION_SECRET=change-me-to-a-long-random-string
ENIGMA_LICENSE_PRIVATE_KEY_PATH=./secrets/enigma-license-private-key.jwk
ENIGMA_LICENSE_KEY_ID=enigma-lic-2026-09
ARTIFACT_DIR=./artifacts
SEED_ADMIN_PASSWORD=changeme-admin
SEED_VIEWER_PASSWORD=changeme-viewer
