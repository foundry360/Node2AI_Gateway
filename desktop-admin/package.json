{
  "name": "@node2ai/desktop-admin",
  "version": "1.0.0",
  "description": "Node2AI Admin Control Center - Desktop Application",
  "main": "main.js",
  "scripts": {
    "dev": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "test": "vitest run --passWithNoTests",
    "test:setup": "./test-desktop-app.sh",
    "test:manual": "echo 'Run: pnpm dev and follow TESTING.md checklist'",
    "test:all": "pnpm test:setup && pnpm test"
  },
  "author": {
    "name": "Foundry360",
    "email": "support@foundry360.com"
  },
  "homepage": "https://node2ai.com",
  "license": "PROPRIETARY",
  "dependencies": {
    "electron-store": "^8.1.0",
    "keytar": "^7.9.0",
    "axios": "^1.6.0"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "vitest": "^1.0.0",
    "prebuild-install": "^7.1.1"
  },
  "build": {
    "appId": "com.foundry360.node2ai.admin",
    "productName": "Node2AI Admin Control Center",
    "copyright": "Copyright © 2025 Foundry360",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "publisherName": "Foundry360"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Development",
      "maintainer": "Foundry360 <support@foundry360.com>",
      "packageCategory": "Development",
      "desktop": {
        "Name": "Node2AI Admin Control Center",
        "Comment": "Node2AI Enterprise Admin Control Center",
        "Categories": "Development;"
      },
      "artifactName": "${productName}-${version}.${ext}",
      "executableName": "node2ai-admin-control-center",
      "vendor": "Foundry360",
      "packageName": "node2ai-admin-control-center"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "files": [
      "**/*",
      "!**/*.md",
      "!node_modules/**/*",
      "!src/**/*",
      "!*.json"
    ]
  }
}
