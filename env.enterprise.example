# Node2AI Enterprise Configuration
# This file contains all configuration options for Node2AI Enterprise Edition

# ============================================
# LICENSE (Required for Enterprise)
# ============================================
LICENSE_KEY=NODE2AI-XXXX-XXXX-XXXX-XXXX-XXXX
# Contact sales@foundry360.com to obtain your license key

# ============================================
# APPLICATION SETTINGS
# ============================================
NODE_ENV=production
APP_NAME=Node2AI Enterprise
APP_URL=https://yourdomain.com
API_URL=https://api.yourdomain.com
WEB_URL=https://yourdomain.com

# ============================================
# SECURITY (CRITICAL - Generate unique values)
# ============================================
# Generate with: openssl rand -base64 32
JWT_SECRET=CHANGE_ME_GENERATE_NEW_SECRET_32_CHARS_MIN
SESSION_SECRET=CHANGE_ME_GENERATE_NEW_SECRET_32_CHARS_MIN

# Generate with: openssl rand -hex 32
PROVIDER_KEY_ENCRYPTION_KEY=CHANGE_ME_GENERATE_NEW_KEY_64_HEX_CHARS

# ============================================
# DATABASE CONFIGURATION
# ============================================
DATABASE_URL=postgresql://node2ai:node2ai_secure_password@postgres:5432/node2ai
DATABASE_POOL_SIZE=20
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# PostgreSQL specific settings
POSTGRES_PASSWORD=node2ai_secure_password
POSTGRES_DB=node2ai
POSTGRES_USER=node2ai

# ============================================
# REDIS CONFIGURATION
# ============================================
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=
REDIS_TLS=false
REDIS_DB=0

# ============================================
# CORS CONFIGURATION
# ============================================
CORS_ORIGINS=https://yourdomain.com,https://admin.yourdomain.com
CORS_CREDENTIALS=true
CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-API-Key,X-Request-ID

# ============================================
# LOGGING CONFIGURATION
# ============================================
LOG_LEVEL=info
ENABLE_REQUEST_LOGGING=true
LOG_FORMAT=json
LOG_FILE_PATH=/var/log/node2ai/app.log

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_WINDOW=60000
RATE_LIMIT_MAX=100
RATE_LIMIT_SKIP_SUCCESSFUL_REQUESTS=false
RATE_LIMIT_SKIP_FAILED_REQUESTS=false

# ============================================
# FEATURE FLAGS
# ============================================
ENABLE_SANITIZATION=true
ENABLE_ANALYTICS=true
ENABLE_AUDIT_LOGS=true
ENABLE_RATE_LIMITING=true
ENABLE_CACHING=true
ENABLE_COMPRESSION=true

# ============================================
# ENTERPRISE FEATURES
# ============================================
# Single Sign-On (SSO)
ENABLE_SSO=false
SSO_PROVIDER=saml
SSO_ENTITY_ID=https://yourdomain.com/saml/metadata
SSO_SSO_URL=https://your-sso-provider.com/sso
SSO_CERT=your-saml-certificate
SSO_PRIVATE_KEY=your-saml-private-key

# Multi-Factor Authentication
ENABLE_MFA=true
MFA_ISSUER=Node2AI Enterprise
MFA_WINDOW=1

# Role-Based Access Control
ENABLE_RBAC=true
RBAC_STRICT_MODE=true

# Advanced Analytics
ENABLE_ADVANCED_ANALYTICS=true
ANALYTICS_RETENTION_DAYS=365
ANALYTICS_BATCH_SIZE=1000

# ============================================
# EMAIL CONFIGURATION
# ============================================
SMTP_HOST=smtp.yourdomain.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=notifications@yourdomain.com
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=Node2AI Enterprise <notifications@yourdomain.com>

# Email templates
EMAIL_TEMPLATE_PATH=/app/templates/email
EMAIL_DEFAULT_LOCALE=en

# ============================================
# MONITORING & OBSERVABILITY
# ============================================
# Sentry for error tracking
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=1.0.0

# New Relic APM
NEW_RELIC_LICENSE_KEY=your-newrelic-license-key
NEW_RELIC_APP_NAME=Node2AI-Enterprise
NEW_RELIC_LOG_ENABLED=true

# Prometheus metrics
ENABLE_METRICS=true
METRICS_PORT=9090
METRICS_PATH=/metrics

# ============================================
# BACKUP & RECOVERY
# ============================================
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=your-node2ai-backups
BACKUP_S3_REGION=us-east-1
BACKUP_S3_ACCESS_KEY=your-s3-access-key
BACKUP_S3_SECRET_KEY=your-s3-secret-key

# ============================================
# SECURITY HEADERS
# ============================================
ENABLE_SECURITY_HEADERS=true
CSP_POLICY=default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=true
HSTS_PRELOAD=true

# ============================================
# PERFORMANCE TUNING
# ============================================
# Node.js settings
NODE_OPTIONS=--max-old-space-size=2048
UV_THREADPOOL_SIZE=16

# Database connection pooling
DB_POOL_MIN=5
DB_POOL_MAX=20
DB_POOL_IDLE_TIMEOUT=30000
DB_POOL_ACQUIRE_TIMEOUT=60000

# Redis connection pooling
REDIS_POOL_MIN=5
REDIS_POOL_MAX=20
REDIS_POOL_IDLE_TIMEOUT=30000

# ============================================
# API CONFIGURATION
# ============================================
API_TIMEOUT=30000
API_MAX_REQUEST_SIZE=10mb
API_MAX_FILES=5
API_MAX_FILE_SIZE=10mb

# ============================================
# CACHE CONFIGURATION
# ============================================
CACHE_TTL=3600
CACHE_MAX_SIZE=1000
CACHE_CHECK_PERIOD=600

# ============================================
# NOTIFICATIONS
# ============================================
# Slack notifications
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url
SLACK_CHANNEL=#node2ai-alerts
SLACK_USERNAME=Node2AI Bot

# Discord notifications
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your/webhook/url

# ============================================
# COMPLIANCE & AUDIT
# ============================================
AUDIT_LOG_LEVEL=info
AUDIT_LOG_RETENTION_DAYS=2555  # 7 years
AUDIT_LOG_ENCRYPTION=true
AUDIT_LOG_COMPRESSION=true

# GDPR compliance
GDPR_ENABLED=true
GDPR_DATA_RETENTION_DAYS=2555
GDPR_AUTO_DELETE=false

# SOC 2 compliance
SOC2_ENABLED=true
SOC2_AUDIT_LOGGING=true
SOC2_ACCESS_CONTROLS=true

# ============================================
# DEVELOPMENT & DEBUGGING
# ============================================
DEBUG=false
DEBUG_SQL=false
DEBUG_REDIS=false
DEBUG_CACHE=false

# ============================================
# CUSTOM INTEGRATIONS
# ============================================
# Webhook endpoints
WEBHOOK_SECRET=your-webhook-secret
WEBHOOK_TIMEOUT=5000
WEBHOOK_RETRY_ATTEMPTS=3

# Custom AI providers
CUSTOM_PROVIDERS_ENABLED=false
CUSTOM_PROVIDERS_PATH=/app/providers/custom

# ============================================
# KUBERNETES SPECIFIC
# ============================================
KUBERNETES_NAMESPACE=node2ai
KUBERNETES_SERVICE_ACCOUNT=node2ai
KUBERNETES_CONFIG_MAP=node2ai-config
KUBERNETES_SECRET=node2ai-secrets

# ============================================
# HEALTH CHECKS
# ============================================
HEALTH_CHECK_INTERVAL=30000
HEALTH_CHECK_TIMEOUT=5000
HEALTH_CHECK_RETRIES=3

# ============================================
# MAINTENANCE MODE
# ============================================
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE=Node2AI is currently under maintenance. Please try again later.
MAINTENANCE_ALLOWED_IPS=127.0.0.1,::1

# ============================================
# VERSION INFORMATION
# ============================================
NODE2AI_VERSION=1.0.0
BUILD_DATE=2024-01-15
COMMIT_HASH=abc123def456
