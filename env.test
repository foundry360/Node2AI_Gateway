# Node2AI Test Environment Configuration
# This file contains test environment variables for live testing

# Database Configuration
DATABASE_URL="postgresql://node2ai:node2ai_password@localhost:5432/node2ai_test"
DATABASE_HOST="localhost"
DATABASE_PORT="5432"
DATABASE_NAME="node2ai_test"
DATABASE_USER="node2ai"
DATABASE_PASSWORD="node2ai_password"

# Redis Configuration
REDIS_URL="redis://localhost:6379"
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_PASSWORD=""

# API Configuration
NODE_ENV="test"
API_PORT="3001"
API_HOST="localhost"
JWT_SECRET="test-jwt-secret-key-for-development-only"
JWT_EXPIRES_IN="24h"

# OpenAI Configuration (Replace with your actual API key)
OPENAI_API_KEY="sk-your-openai-api-key-here"
OPENAI_ORGANIZATION="org-your-organization-id"

# Anthropic Configuration (Optional)
ANTHROPIC_API_KEY="sk-ant-your-anthropic-api-key-here"

# Google AI Configuration (Optional)
GOOGLE_AI_API_KEY="your-google-ai-api-key-here"

# Perplexity Configuration (Optional)
PERPLEXITY_API_KEY="pplx-your-perplexity-api-key-here"

# Encryption Configuration
ENCRYPTION_KEY="test-encryption-key-32-chars-long"
ENCRYPTION_ALGORITHM="aes-256-gcm"

# Logging Configuration
LOG_LEVEL="debug"
LOG_FORMAT="json"

# Rate Limiting
RATE_LIMIT_WINDOW_MS="900000"
RATE_LIMIT_MAX_REQUESTS="100"

# CORS Configuration
CORS_ORIGIN="http://localhost:3000,http://localhost:3001"

# File Upload Configuration
MAX_FILE_SIZE="10485760"
UPLOAD_DIR="./uploads"

# Backup Configuration
BACKUP_DIR="./backups"
BACKUP_RETENTION_DAYS="7"

# Monitoring Configuration
ENABLE_METRICS="true"
METRICS_PORT="9090"

# Test Data Configuration
SEED_TEST_DATA="true"
TEST_USER_EMAIL="test@node2ai.ai"
TEST_USER_PASSWORD="test123456"
TEST_ORG_NAME="Node2AI Test Organization"

# Security Configuration
BCRYPT_ROUNDS="10"
SESSION_SECRET="test-session-secret"
CSRF_SECRET="test-csrf-secret"

# Feature Flags
ENABLE_PII_SANITIZATION="true"
ENABLE_MULTI_PROVIDER="true"
ENABLE_SMART_ROUTING="true"
ENABLE_AUDIT_LOGGING="true"
ENABLE_BACKUP_AUTOMATION="true"
