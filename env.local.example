# Node2AI Development Environment Configuration
# Copy this to .env.local in the apps/api directory

# Database Configuration
DATABASE_URL="postgresql://postgres:password@localhost:5432/node2ai_dev"

# API Configuration
NODE_ENV="development"
API_PORT="3001"
JWT_SECRET="dev-jwt-secret-key-change-in-production"
JWT_EXPIRES_IN="24h"

# OpenAI Configuration (Replace with your actual API key)
OPENAI_API_KEY="sk-your-openai-api-key-here"

# Redis Configuration (Optional)
REDIS_URL="redis://localhost:6379"

# Encryption Configuration
ENCRYPTION_KEY="dev-encryption-key-32-chars-long"
ENCRYPTION_ALGORITHM="aes-256-gcm"

# Logging Configuration
LOG_LEVEL="debug"
LOG_FORMAT="json"

# Rate Limiting
RATE_LIMIT_WINDOW_MS="900000"
RATE_LIMIT_MAX_REQUESTS="100"

# CORS Configuration
CORS_ORIGIN="http://localhost:3000,http://localhost:3001"

# File Upload Configuration
MAX_FILE_SIZE="10485760"
UPLOAD_DIR="./uploads"

# Backup Configuration
BACKUP_DIR="./backups"
BACKUP_RETENTION_DAYS="7"

# Monitoring Configuration
ENABLE_METRICS="true"
METRICS_PORT="9090"

# Test Data Configuration
SEED_TEST_DATA="true"
TEST_USER_EMAIL="admin@node2ai.ai"
TEST_USER_PASSWORD="admin123"
TEST_ORG_NAME="Node2AI Development Organization"

# Security Configuration
BCRYPT_ROUNDS="10"
SESSION_SECRET="dev-session-secret"
CSRF_SECRET="dev-csrf-secret"

# Feature Flags
ENABLE_PII_SANITIZATION="true"
ENABLE_MULTI_PROVIDER="true"
ENABLE_SMART_ROUTING="true"
ENABLE_AUDIT_LOGGING="true"
ENABLE_BACKUP_AUTOMATION="true"
