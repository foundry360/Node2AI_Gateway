{
  "name": "@node2/sdk",
  "version": "1.0.0",
  "description": "TypeScript SDK for Node2AI integration - provides client libraries for API, sanitization, and compliance features",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./api": {
      "types": "./dist/api/index.d.ts",
      "import": "./dist/api/index.js",
      "require": "./dist/api/index.js"
    },
    "./sanitization": {
      "types": "./dist/sanitization/index.d.ts",
      "import": "./dist/sanitization/index.js",
      "require": "./dist/sanitization/index.js"
    },
    "./compliance": {
      "types": "./dist/compliance/index.d.ts",
      "import": "./dist/compliance/index.js",
      "require": "./dist/compliance/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "type-check": "tsc --noEmit",
    "lint": "echo 'Lint check skipped for sdk package' || exit 0",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "test": "echo 'No tests configured for @node2/sdk' && exit 0",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "docs": "typedoc src --out docs"
  },
  "dependencies": {
    "@node2/shared": "workspace:*",
    "@node2/sanitization": "workspace:*",
    "axios": "^1.6.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0",
    "@vitest/coverage-v8": "^1.0.0",
    "typedoc": "^0.25.0"
  },
  "files": [
    "dist",
    "docs"
  ],
  "publishConfig": {
    "access": "restricted"
  },
  "keywords": [
    "node2",
    "ai",
    "sdk",
    "typescript",
    "api",
    "sanitization",
    "compliance"
  ]
}
