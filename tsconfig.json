{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@node2/shared": ["./packages/shared/src"],
      "@node2/shared/*": ["./packages/shared/src/*"],
      "@node2/sdk": ["./packages/sdk/src"],
      "@node2/sdk/*": ["./packages/sdk/src/*"],
      "@node2/sanitization": ["./packages/sanitization/src"],
      "@node2/sanitization/*": ["./packages/sanitization/src/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "**/*.js",
    "**/*.jsx",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules", "dist", "build", ".next", "coverage"]
}
