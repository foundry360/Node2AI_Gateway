### Node2AI API Environment Template
# Copy to .env.local for local development

# Database connection (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/node2ai_dev

# Core server configuration
NODE_ENV=development
PORT=3001

# Authentication & security
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"
JWT_SECRET=replace-with-generated-secret
API_KEY_SECRET=dev-api-key-secret

# Optional feature toggles
BLOCKCHAIN_ENABLED=false
DATA_SANITIZATION_ENABLED=true


