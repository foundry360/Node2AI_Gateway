// Node2AI Prisma Schema
// Self-hosted AI gateway with data sanitization and compliance features
// Supports pgvector extension for RAG capabilities

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  extensions = [vector, pg_trgm, btree_gin]
}

// =============================================================================
// CORE ENTITIES
// =============================================================================

model Organization {
  id                String    @id @default(uuid()) @db.Uuid
  name              String
  deploymentMode    String    @default("self-hosted") @map("deployment_mode")
  licenseTier       String    @default("standard") @map("license_tier")
  licenseKey        String?   @map("license_key")
  licenseExpiresAt  DateTime? @map("license_expires_at") @db.Timestamptz
  maxInstances      Int       @default(1) @map("max_instances")
  isActive          Boolean   @default(true) @map("is_active")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  users             User[]
  apiKeys           ApiKey[]
  providerKeys      ProviderKey[]
  usageEvents       UsageEvent[]
  tokenMappings     TokenMapping[]
  curatedSources    CuratedSource[]
  auditLogs         AuditLog[]
  integrations      Integration[]
  aiRequests        AIRequest[]
  conversationSessions ConversationSession[]
  systemEvents      SystemEvent[]
  rateLimitEvents   RateLimitEvent[]
  auditRetentionPolicies AuditRetentionPolicy[]

  @@map("organizations")
  @@index([deploymentMode])
  @@index([licenseTier])
  @@index([isActive])
}

model User {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  email          String
  name           String
  role           String    @default("viewer")
  passwordHash   String?   @map("password_hash")
  ssoId          String?   @map("sso_id")
  ssoProvider    String?   @map("sso_provider")
  isActive       Boolean   @default(true) @map("is_active")
  lastLoginAt    DateTime? @map("last_login_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  apiKeys        ApiKey[]
  usageEvents    UsageEvent[]
  auditLogs      AuditLog[]
  aiRequests     AIRequest[]
  conversationSessions ConversationSession[]

  @@map("users")
  @@unique([organizationId, email])
  @@index([organizationId])
  @@index([email])
  @@index([role])
  @@index([isActive])
  @@index([lastLoginAt])
}

model ApiKey {
  id                String    @id @default(uuid()) @db.Uuid
  organizationId    String    @map("organization_id") @db.Uuid
  name              String
  keyHash           String    @unique @map("key_hash")
  rateLimitPerMinute Int      @default(1000) @map("rate_limit_per_minute")
  expiresAt         DateTime? @map("expires_at") @db.Timestamptz
  lastUsedAt        DateTime? @map("last_used_at") @db.Timestamptz
  isActive          Boolean   @default(true) @map("is_active")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  createdBy         String?   @map("created_by") @db.Uuid

  // Relations
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdByUser     User?        @relation(fields: [createdBy], references: [id])
  usageEvents       UsageEvent[]
  aiRequests        AIRequest[]
  rateLimitEvents   RateLimitEvent[]

  @@map("api_keys")
  @@index([organizationId])
  @@index([keyHash])
  @@index([isActive])
  @@index([expiresAt])
  @@index([lastUsedAt])
}

model ProviderKey {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  provider       String
  encryptedKey   String    @map("encrypted_key")
  environment    String    @default("production")
  keyMetadata    Json?     @map("key_metadata")
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("provider_keys")
  @@unique([organizationId, provider])
  @@index([organizationId])
  @@index([provider])
  @@index([isActive])
}

model UsageEvent {
  id                String    @id @default(uuid()) @db.Uuid
  organizationId    String    @map("organization_id") @db.Uuid
  apiKeyId          String?   @map("api_key_id") @db.Uuid
  userId            String?   @map("user_id") @db.Uuid
  provider          String
  model             String
  tokensInput       Int       @default(0) @map("tokens_input")
  tokensOutput      Int       @default(0) @map("tokens_output")
  cost              Decimal   @default(0) @db.Decimal(10, 6)
  latencyMs         Int       @default(0) @map("latency_ms")
  status            String    @default("success")
  errorMessage      String?   @map("error_message")
  dataSanitized     Boolean   @default(false) @map("data_sanitized")
  sanitizationCount Int       @default(0) @map("sanitization_count")
  requestId         String?   @map("request_id")
  timestamp         DateTime  @default(now()) @db.Timestamptz
  metadata          Json?

  // Relations
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  apiKey            ApiKey?      @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)
  user              User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("usage_events")
  @@index([organizationId])
  @@index([apiKeyId])
  @@index([userId])
  @@index([provider])
  @@index([model])
  @@index([status])
  @@index([timestamp])
  @@index([dataSanitized])
  @@index([cost])
}

model TokenMapping {
  id                      String    @id @default(uuid()) @db.Uuid
  organizationId          String    @map("organization_id") @db.Uuid
  sessionId               String    @map("session_id")
  tokenType               String    @map("token_type")
  token                   String
  encryptedOriginalValue  String    @map("encrypted_original_value")
  confidence              Decimal   @default(0.0) @db.Decimal(3, 2)
  category                String
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz
  expiresAt               DateTime  @map("expires_at") @db.Timestamptz

  // Relations
  organization            Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("token_mappings")
  @@unique([organizationId, sessionId, token])
  @@index([organizationId])
  @@index([sessionId])
  @@index([token])
  @@index([expiresAt])
  @@index([tokenType])
  @@index([category])
}

model CuratedSource {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String
  sourceType     String    @map("source_type")
  storagePath    String    @map("storage_path")
  sizeBytes      BigInt    @default(0) @map("size_bytes")
  chunkCount     Int       @default(0) @map("chunk_count")
  status         String    @default("pending")
  errorMessage   String?   @map("error_message")
  metadata       Json?
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  embeddings     VectorEmbedding[]

  @@map("curated_sources")
  @@index([organizationId])
  @@index([sourceType])
  @@index([status])
  @@index([createdAt])
}

model VectorEmbedding {
  id           String    @id @default(uuid()) @db.Uuid
  sourceId     String    @map("source_id") @db.Uuid
  chunkText    String    @map("chunk_text")
  embedding    Unsupported("vector(1536)") // pgvector type
  chunkIndex   Int       @default(0) @map("chunk_index")
  metadata     Json?
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  source       CuratedSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@map("vector_embeddings")
  @@index([sourceId])
  @@index([createdAt])
}

model AuditLog {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  userId         String?   @map("user_id") @db.Uuid
  action         String
  resourceType   String    @map("resource_type")
  resourceId     String?   @map("resource_id") @db.Uuid
  details        Json?
  ipAddress      String?   @map("ip_address") @db.Inet
  userAgent      String?   @map("user_agent")
  severity       String    @default("info")
  timestamp      DateTime  @default(now()) @db.Timestamptz

  // Relations
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
  @@index([organizationId])
  @@index([userId])
  @@index([action])
  @@index([resourceType])
  @@index([timestamp])
  @@index([severity])
}

model Integration {
  id           String    @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  type         String
  name         String
  config       Json
  isActive     Boolean   @default(true) @map("is_active")
  lastSyncAt   DateTime? @map("last_sync_at") @db.Timestamptz
  syncStatus   String    @default("idle") @map("sync_status")
  errorMessage String?   @map("error_message")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  events       IntegrationEvent[]

  @@map("integrations")
  @@index([organizationId])
  @@index([type])
  @@index([isActive])
  @@index([syncStatus])
}

model IntegrationEvent {
  id            String    @id @default(uuid()) @db.Uuid
  integrationId String    @map("integration_id") @db.Uuid
  eventType     String    @map("event_type")
  status        String
  details       Json?
  errorMessage  String?   @map("error_message")
  timestamp     DateTime  @default(now()) @db.Timestamptz

  // Relations
  integration   Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@map("integration_events")
  @@index([integrationId])
  @@index([eventType])
  @@index([status])
  @@index([timestamp])
}

// =============================================================================
// COMPLIANCE & AUDIT LOGGING SYSTEM
// =============================================================================

model AIRequest {
  id                      String    @id @default(uuid()) @db.Uuid
  requestId               String    @unique @map("request_id")
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz
  completedAt             DateTime? @map("completed_at") @db.Timestamptz
  durationMs              Int?      @map("duration_ms")

  // Customer Context
  organizationId          String    @map("organization_id") @db.Uuid
  userId                  String?   @map("user_id") @db.Uuid
  apiKeyId                String?   @map("api_key_id") @db.Uuid
  applicationId           String?   @map("application_id") @db.Uuid

  // Request Details
  endpoint                String
  httpMethod              String    @map("http_method")
  ipAddress               String?   @map("ip_address") @db.Inet
  userAgent               String?   @map("user_agent") @db.Text

  // AI Provider Details
  provider                String
  model                   String
  deploymentMode          String    @map("deployment_mode")

  // Input Metrics
  inputMessageCount       Int       @default(0) @map("input_message_count")
  inputTokenCount         Int       @default(0) @map("input_token_count")
  inputCharacterCount     Int       @default(0) @map("input_character_count")
  inputHash              String?   @map("input_hash") @db.VarChar(64)

  // Sanitization Details (CRITICAL)
  sanitizationEnabled     Boolean   @default(true) @map("sanitization_enabled")
  piiDetectedCount        Int       @default(0) @map("pii_detected_count")
  phiDetectedCount        Int       @default(0) @map("phi_detected_count")
  sanitizationTypes       Json?     @map("sanitization_types")
  sanitizationDurationMs  Int?      @map("sanitization_duration_ms")

  // Output Metrics
  outputTokenCount        Int?      @map("output_token_count")
  outputCharacterCount    Int?      @map("output_character_count")
  outputHash              String?   @map("output_hash") @db.VarChar(64)
  finishReason            String?   @map("finish_reason")

  // Status & Error Handling
  status                  String    @default("pending")
  httpStatusCode          Int?      @map("http_status_code")
  errorType               String?   @map("error_type")
  errorMessage            String?   @map("error_message") @db.Text
  retryCount              Int       @default(0) @map("retry_count")

  // Cost Tracking
  costUsd                 Decimal?  @map("cost_usd") @db.Decimal(10, 6)
  costInputUsd            Decimal?  @map("cost_input_usd") @db.Decimal(10, 6)
  costOutputUsd           Decimal?  @map("cost_output_usd") @db.Decimal(10, 6)
  pricingTier             String?   @map("pricing_tier")

  // Performance Metrics
  queueTimeMs             Int?      @map("queue_time_ms")
  aiProviderTimeMs        Int?      @map("ai_provider_time_ms")
  desanitizationTimeMs    Int?      @map("desanitization_time_ms")

  // Compliance
  complianceFlags         Json?     @map("compliance_flags")
  retentionPolicy         String?   @map("retention_policy")
  auditReviewed          Boolean   @default(false) @map("audit_reviewed")
  auditReviewedBy         String?   @map("audit_reviewed_by") @db.Uuid
  auditReviewedAt         DateTime? @map("audit_reviewed_at") @db.Timestamptz

  // Metadata
  requestMetadata         Json?     @map("request_metadata")
  responseMetadata        Json?     @map("response_metadata")
  tags                    String[]

  // Soft Delete
  deletedAt               DateTime? @map("deleted_at") @db.Timestamptz

  // Relations
  organization            Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user                    User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  apiKey                  ApiKey?      @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)
  sanitizationEvents      SanitizationEvent[]
  conversationMessage     ConversationMessage[]

  @@map("ai_requests")
  @@index([organizationId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([provider, model, createdAt(sort: Desc)])
  @@index([sanitizationEnabled, piiDetectedCount])
}

model SanitizationEvent {
  id              String    @id @default(uuid()) @db.Uuid
  requestId       String    @map("request_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz

  // Entity Details
  entityType      String    @map("entity_type")
  entityCategory  String    @map("entity_category")
  detectionMethod String    @map("detection_method")
  confidenceScore Decimal   @map("confidence_score") @db.Decimal(3, 2)

  // Location in Text
  positionStart   Int       @map("position_start")
  positionEnd     Int       @map("position_end")
  contextBefore   String?   @map("context_before") @db.Text
  contextAfter    String?   @map("context_after") @db.Text

  // Tokenization
  tokenId         String    @map("token_id") @db.VarChar(50)
  tokenExpiry     DateTime? @map("token_expiry") @db.Timestamptz

  // Actions
  action          String
  originalLength Int       @map("original_length")

  // Metadata
  metadata      Json?

  // Relations
  request       AIRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@map("sanitization_events")
  @@index([requestId])
  @@index([entityType, createdAt(sort: Desc)])
}

model ConversationSession {
  id              String    @id @default(uuid()) @db.Uuid
  sessionId       String    @unique @map("session_id")
  organizationId String    @map("organization_id") @db.Uuid
  userId          String?   @map("user_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  lastActivityAt  DateTime? @map("last_activity_at") @db.Timestamptz
  closedAt        DateTime? @map("closed_at") @db.Timestamptz

  // Conversation Details
  title           String?   @db.Text
  messageCount    Int       @default(0) @map("message_count")
  totalInputTokens Int      @default(0) @map("total_input_tokens")
  totalOutputTokens Int     @default(0) @map("total_output_tokens")
  totalCostUsd    Decimal   @default(0) @map("total_cost_usd") @db.Decimal(10, 6)

  // Context
  contextMetadata Json?     @map("context_metadata")
  tags            String[]

  // Status
  status          String    @default("active")

  // Relations
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user            User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  messages        ConversationMessage[]

  @@map("conversation_sessions")
  @@index([organizationId, createdAt(sort: Desc)])
  @@index([userId, lastActivityAt(sort: Desc)])
}

model ConversationMessage {
  id            String    @id @default(uuid()) @db.Uuid
  sessionId     String    @map("session_id") @db.Uuid
  requestId     String?   @map("request_id") @db.Uuid
  messageOrder  Int       @map("message_order")
  role          String
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz

  // Content (hashed, not stored verbatim)
  contentHash   String    @map("content_hash") @db.VarChar(64)
  contentLength Int       @map("content_length")
  tokenCount    Int       @map("token_count")

  // Sanitization
  containedPii  Boolean   @default(false) @map("contained_pii")
  piiTypes      Json?     @map("pii_types")

  // Metadata
  metadata      Json?

  // Relations
  session       ConversationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  request       AIRequest?          @relation(fields: [requestId], references: [id], onDelete: SetNull)

  @@map("conversation_messages")
  @@index([sessionId, messageOrder])
  @@index([requestId])
}

model SystemEvent {
  id            String    @id @default(uuid()) @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz

  // Event Details
  eventType     String    @map("event_type")
  eventCategory String    @map("event_category")
  severity      String    @default("info")

  // Actor (who did it)
  actorType     String    @map("actor_type")
  actorId       String?   @map("actor_id") @db.Uuid
  actorIp       String?   @map("actor_ip") @db.Inet
  actorUserAgent String?  @map("actor_user_agent") @db.Text

  // Target (what was affected)
  targetType    String?   @map("target_type")
  targetId      String?   @map("target_id") @db.Uuid

  // Action
  action        String
  description   String?   @db.Text

  // Before/After State
  changes       Json?

  // Context
  organizationId String?  @map("organization_id") @db.Uuid
  requestId     String?   @map("request_id")

  // Status
  status        String
  errorMessage  String?   @map("error_message") @db.Text

  // Relations
  organization  Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("system_events")
  @@index([eventType, createdAt(sort: Desc)])
  @@index([eventCategory, createdAt(sort: Desc)])
  @@index([organizationId, createdAt(sort: Desc)])
}

model RateLimitEvent {
  id                  String    @id @default(uuid()) @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz

  // Who
  organizationId      String    @map("organization_id") @db.Uuid
  apiKeyId            String?   @map("api_key_id") @db.Uuid
  ipAddress           String?   @map("ip_address") @db.Inet

  // Limit Details
  limitType           String    @map("limit_type")
  limitValue          Int       @map("limit_value")
  currentValue        Int       @map("current_value")
  windowStart         DateTime? @map("window_start") @db.Timestamptz
  windowEnd           DateTime? @map("window_end") @db.Timestamptz

  // Action
  action              String
  retryAfterSeconds   Int?      @map("retry_after_seconds")

  // Relations
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  apiKey              ApiKey?     @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)

  @@map("rate_limit_events")
  @@index([organizationId, createdAt(sort: Desc)])
  @@index([limitType, createdAt(sort: Desc)])
}

model ComplianceReview {
  id                String    @id @default(uuid()) @db.Uuid
  reviewType        String    @map("review_type")
  reviewPeriodStart DateTime? @map("review_period_start") @db.Timestamptz
  reviewPeriodEnd   DateTime? @map("review_period_end") @db.Timestamptz

  // Reviewer
  reviewedBy        String    @map("reviewed_by") @db.Uuid
  reviewedAt        DateTime  @map("reviewed_at") @db.Timestamptz

  // Scope
  organizationId    String?   @map("organization_id") @db.Uuid
  requestIds        String[]  @map("request_ids")
  sampleSize        Int?      @map("sample_size")

  // Findings
  findings          String?   @db.Text
  issuesFound       Int       @default(0) @map("issues_found")
  complianceStatus  String    @map("compliance_status")

  // Actions
  actionsRequired   String?   @map("actions_required") @db.Text
  followUpRequired  Boolean   @default(false) @map("follow_up_required")
  followUpDate      DateTime? @map("follow_up_date") @db.Date

  // Metadata
  metadata          Json?

  @@map("compliance_reviews")
  @@index([organizationId, reviewedAt(sort: Desc)])
  @@index([complianceStatus, reviewedAt(sort: Desc)])
}

model AuditRetentionPolicy {
  id                  String    @id @default(uuid()) @db.Uuid
  organizationId      String    @map("organization_id") @db.Uuid

  // Policy
  policyName          String    @map("policy_name")
  retentionPeriodDays Int       @map("retention_period_days")
  appliesTo           String    @map("applies_to")

  // Conditions
  conditions          Json?

  // Legal
  regulation          String?
  legalHold           Boolean   @default(false) @map("legal_hold")

  // Automation
  autoDeleteEnabled   Boolean   @default(false) @map("auto_delete_enabled")
  lastPurgeAt         DateTime? @map("last_purge_at") @db.Timestamptz
  nextPurgeAt         DateTime? @map("next_purge_at") @db.Timestamptz

  // Timestamps
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("audit_retention_policies")
  @@index([organizationId])
  @@index([policyName])
}
