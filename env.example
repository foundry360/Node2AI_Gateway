# Node2AI Environment Configuration
# Copy this file to .env and update with your values

# =============================================================================
# DEPLOYMENT CONFIGURATION
# =============================================================================

# Environment mode
NODE_ENV=development

# Deployment mode: cloud | self-hosted | airgap
DEPLOYMENT_MODE=self-hosted

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# PostgreSQL connection string
DATABASE_URL=postgresql://node2:changeme@postgres:5432/node2ai

# PostgreSQL individual settings
POSTGRES_DB=node2ai
POSTGRES_USER=node2
POSTGRES_PASSWORD=changeme

# Database SSL configuration
DATABASE_SSL=false
DATABASE_POOL_SIZE=10
DATABASE_TIMEOUT=30000

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================

# Redis connection string
REDIS_URL=redis://:changeme@redis:6379

# Redis password
REDIS_PASSWORD=changeme

# Redis database number (0-15)
REDIS_DB=0

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================

# JWT secret for token signing (generate with: openssl rand -base64 32)
JWT_SECRET=dev-jwt-secret-change-in-production

# Encryption key for data at rest (generate with: openssl rand -base64 32)
ENCRYPTION_KEY=dev-encryption-key-change-in-production

# Provider key encryption key (generate with: openssl rand -base64 32)
PROVIDER_KEY_ENCRYPTION_KEY=dev-provider-key-encryption-key-change-in-production

# API key secret for external API access
API_KEY_SECRET=dev-api-key-secret

# =============================================================================
# LICENSE MANAGEMENT
# =============================================================================

# License signing keys (generate with: npm run generate-license-keys)
# These are RSA keys used to sign and verify license keys
# NEVER commit the private key to version control!
LICENSE_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\\nMIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEA...\\n-----END PUBLIC KEY-----
LICENSE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\\nMIIEvQIBADANBgkqhkiG9w0BAQEFAASCBKcwggSjAgEAAoIBAQC...\\n-----END PRIVATE KEY-----

# Optional: Pre-configured license key (for development/testing)
# LICENSE_KEY=your-license-key-here

# =============================================================================
# API CONFIGURATION
# =============================================================================

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Session timeout in seconds (default: 2 hours)
SESSION_TIMEOUT=7200

# =============================================================================
# FEATURE FLAGS
# =============================================================================

# Enable data sanitization engine
DATA_SANITIZATION_ENABLED=true

# Enable external AI providers (OpenAI, Anthropic, etc.)
EXTERNAL_AI_ENABLED=true

# Enable local LLM (Ollama)
LOCAL_LLM_ENABLED=false

# Local LLM URL (when LOCAL_LLM_ENABLED=true)
LOCAL_LLM_URL=http://ollama:11434

# =============================================================================
# LICENSE CONFIGURATION
# =============================================================================

# License key for self-hosted deployment
LICENSE_KEY=DEV-LICENSE-KEY

# License tier: standard | professional | enterprise
LICENSE_TIER=enterprise

# License validation URL (for cloud deployment)
LICENSE_VALIDATION_URL=https://license.node2.ai/validate

# =============================================================================
# AI PROVIDER CONFIGURATION
# =============================================================================

# OpenAI API Key (optional)
OPENAI_API_KEY=

# Anthropic API Key (optional)
ANTHROPIC_API_KEY=

# Google AI API Key (optional)
GOOGLE_API_KEY=

# Azure OpenAI Configuration (optional)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# =============================================================================
# LOCAL LLM CONFIGURATION
# =============================================================================

# Ollama model to use for local inference
OLLAMA_MODEL=llama2:7b

# Ollama API timeout in milliseconds
OLLAMA_TIMEOUT=30000

# Maximum tokens for local LLM
OLLAMA_MAX_TOKENS=2048

# =============================================================================
# SANITIZATION CONFIGURATION
# =============================================================================

# Sanitization strict mode (more aggressive detection)
SANITIZATION_STRICT_MODE=true

# Data retention period in days
DATA_RETENTION_DAYS=30

# Enable audit logging
AUDIT_LOGGING=true

# Enable data encryption at rest
DATA_ENCRYPTION_AT_REST=true

# =============================================================================
# BLOCKCHAIN CONFIGURATION (Hyperledger Fabric)
# =============================================================================

# Enable blockchain audit trail (default: true for production)
BLOCKCHAIN_ENABLED=true

# Path to Hyperledger Fabric connection profile JSON
# Default: ~/hyperledger/fabric-samples/test-network/organizations/peerOrganizations/org1.example.com/connection-org1.json
# For production: Use absolute path to your production connection profile
BLOCKCHAIN_CONNECTION_PROFILE=

# Path to blockchain wallet directory (stores identities)
# Default: ./blockchain/wallet
BLOCKCHAIN_WALLET_PATH=

# Fabric channel name (default: node2aichannel)
BLOCKCHAIN_CHANNEL_NAME=node2aichannel

# Chaincode name (default: node2ai)
BLOCKCHAIN_CHAINCODE_NAME=node2ai

# Organization MSP ID (default: Org1MSP)
BLOCKCHAIN_ORG_MSP=Org1MSP

# User ID for blockchain operations (default: appUser)
BLOCKCHAIN_USER_ID=appUser

# Blockchain signing key for digital signatures (generate with: openssl rand -base64 32)
BLOCKCHAIN_SIGNING_KEY=

# Blockchain public key (if using custom keys)
BLOCKCHAIN_PUBLIC_KEY=

# =============================================================================
# COMPLIANCE CONFIGURATION
# =============================================================================

# Compliance mode: strict | standard | relaxed
COMPLIANCE_MODE=strict

# GDPR compliance
GDPR_COMPLIANT=true

# HIPAA compliance
HIPAA_COMPLIANT=true

# SOX compliance
SOX_COMPLIANT=true

# =============================================================================
# MONITORING AND LOGGING
# =============================================================================

# Log level: debug | info | warn | error
LOG_LEVEL=debug

# Enable metrics collection
METRICS_ENABLED=true

# Health check interval in seconds
HEALTH_CHECK_INTERVAL=30

# =============================================================================
# DOCKER CONFIGURATION
# =============================================================================

# Docker registry for images
DOCKER_REGISTRY=

# Docker image tag
DOCKER_TAG=latest

# =============================================================================
# KUBERNETES CONFIGURATION
# =============================================================================

# Kubernetes namespace
K8S_NAMESPACE=node2

# Kubernetes storage class
K8S_STORAGE_CLASS=standard

# =============================================================================
# BACKUP CONFIGURATION
# =============================================================================

# Enable automated backups
BACKUP_ENABLED=true

# Backup schedule (cron format)
BACKUP_SCHEDULE=0 2 * * *

# Backup retention in days
BACKUP_RETENTION_DAYS=30

# Backup storage path
BACKUP_STORAGE_PATH=/backups

# =============================================================================
# DEVELOPMENT CONFIGURATION
# =============================================================================

# Enable hot reload in development
HOT_RELOAD=true

# Enable debug mode
DEBUG_MODE=true

# Development data seeding
SEED_DEVELOPMENT_DATA=true

# =============================================================================
# PRODUCTION CONFIGURATION
# =============================================================================

# Production domain
PRODUCTION_DOMAIN=node2.local

# SSL certificate path
SSL_CERT_PATH=/etc/ssl/certs/node2.crt

# SSL private key path
SSL_KEY_PATH=/etc/ssl/private/node2.key

# =============================================================================
# ADVANCED CONFIGURATION
# =============================================================================

# Maximum file upload size in MB
MAX_UPLOAD_SIZE=100

# API rate limiting (requests per minute)
RATE_LIMIT_PER_MINUTE=1000

# WebSocket configuration
WEBSOCKET_ENABLED=true
WEBSOCKET_PORT=3002

# Cache TTL in seconds
CACHE_TTL=3600

# =============================================================================
# ENVIRONMENT-SPECIFIC OVERRIDES
# =============================================================================

# Development overrides (uncomment for development)
# NODE_ENV=development
# LOG_LEVEL=debug
# DEBUG_MODE=true
# HOT_RELOAD=true

# Production overrides (uncomment for production)
# NODE_ENV=production
# LOG_LEVEL=info
# DEBUG_MODE=false
# HOT_RELOAD=false
# DATA_ENCRYPTION_AT_REST=true
# AUDIT_LOGGING=true