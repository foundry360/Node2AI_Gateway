# Enigma Gateway appliance — copy to .env and fill secrets.
# Note: default POSTGRES_USER / POSTGRES_DB may still use historical node2ai
# identifiers for compatibility. The product name is Enigma.
# Never commit a real .env. install.sh generates secrets if missing.

# Required secrets (install.sh generates these)
POSTGRES_PASSWORD=
GATEWAY_ADMIN_API_KEY=
GATEWAY_VAULT_KEY=
# Optional dedicated HMAC key for audit hash chain (defaults to GATEWAY_VAULT_KEY)
GATEWAY_AUDIT_KEY=

# Phase 1 — signed audit checkpoints (Ed25519 JWK paths or inline JSON)
# GATEWAY_AUDIT_CHECKPOINT_PRIVATE_JWK=/run/secrets/audit-checkpoint-private.jwk
# GATEWAY_AUDIT_CHECKPOINT_PUBLIC_JWKS=/run/secrets/audit-checkpoint-public.jwks
# Event threshold (default 500). Alias: GATEWAY_AUDIT_CHECKPOINT_EVENT_THRESHOLD
# GATEWAY_AUDIT_CHECKPOINT_EVERY_EVENTS=500
# Time threshold seconds (default 900 = 15 minutes)
# GATEWAY_AUDIT_CHECKPOINT_INTERVAL_SECONDS=900
# GATEWAY_AUDIT_CHECKPOINTING_ENABLED=true
# GATEWAY_AUDIT_CHECKPOINT_MAX_PER_TICK=5

# Phase 2 — external evidence anchoring (filesystem for dev / air-gap)
# GATEWAY_AUDIT_ANCHORING_ENABLED=true
# GATEWAY_AUDIT_ANCHOR_PROVIDER=filesystem
# GATEWAY_AUDIT_ANCHOR_LOCATION=/var/lib/enigma/audit-anchors
# GATEWAY_AUDIT_ANCHOR_ON_CHECKPOINT=true

# Phase 3A — customer S3 Object Lock (optional; IAM role preferred, no secrets in DB)
# GATEWAY_AUDIT_ANCHOR_PROVIDER=s3
# GATEWAY_AUDIT_ANCHOR_S3_BUCKET=
# GATEWAY_AUDIT_ANCHOR_S3_PREFIX=
# GATEWAY_AUDIT_ANCHOR_S3_REGION=
# GATEWAY_AUDIT_ANCHOR_ASYNC=true
# GATEWAY_AUDIT_ANCHOR_MAX_ATTEMPTS=8

# Database
POSTGRES_USER=node2ai
POSTGRES_DB=node2ai_gateway
POSTGRES_PORT=5433

# Gateway
# Product 1.0 production-safe defaults (explicit in docker-compose):
#   GATEWAY_ACTOR_REGISTRY_MODE=enforce
#   GATEWAY_POLICY_ENGINE=enterprise
#   GATEWAY_ALLOW_LEGACY_ENGINE=false
#   GATEWAY_FAIL_CLOSED_AUDIT=true
# Agent/Tool registry: off = legacy client attestation | shadow = resolve+compare | enforce = server authority
# GATEWAY_ACTOR_REGISTRY_MODE=enforce
# GATEWAY_FAIL_CLOSED_AUDIT=true
# Production-shaped deploys (ENIGMA_LICENSE_MODE=production, NODE_ENV=production, or DATABASE_URL set)
# refuse actor=off, audit fail-open, and the built-in admin key unless:
# GATEWAY_ALLOW_INSECURE_CONFIG=true
GATEWAY_PORT=8080
GATEWAY_DEPLOYMENT_MODE=connected
# Enigma EPA: enterprise (default) | shadow | legacy|compare only if GATEWAY_ALLOW_LEGACY_ENGINE=true
# GATEWAY_POLICY_ENGINE=enterprise
# GATEWAY_ALLOW_LEGACY_ENGINE=false
# Compatibility modes must never silently weaken Product 1.0 production governance.
# Optional split duties (default = GATEWAY_ADMIN_API_KEY):
# GATEWAY_POLICY_APPROVER_KEY=
# GATEWAY_POLICY_ACTIVATOR_KEY=
GATEWAY_LOCAL_RUNTIME=ollama
GATEWAY_OLLAMA_MODEL=llama3.2
GATEWAY_CORS_ORIGINS=http://localhost:3080,http://127.0.0.1:3080
ADMIN_PORT=3080
OLLAMA_PORT=11434

# Connected mode only (leave empty in air-gap)
GATEWAY_EXTERNAL_PROVIDER_URL=
# Optional appliance-level fallback for OpenAI-compatible providers.
# Prefer per-application BYOK credentials in Admin → Applications.
# GATEWAY_EXTERNAL_PROVIDER_URL=https://api.openai.com
# GATEWAY_EXTERNAL_PROVIDER_API_KEY=

# Optional Enigma license (Phase 2 — signed offline licensing).
#
# Mode:
#   development — unsigned ENIGMA_LICENSE_* env defaults (local / tests)
#   production  — requires a vendor-signed Ed25519 license file (fail closed)
#
# Compose appliances default to production. Local `npm test` / createPhase1Gateway
# leave ENIGMA_LICENSE_MODE unset → development.
#
# ENIGMA_LICENSE_MODE=production
# ENIGMA_LICENSE_PATH=/etc/enigma/license/enigma.license
# Optional for tests only (prefer file in production):
# ENIGMA_LICENSE_DOCUMENT=<compact-jws>
#
# Development unsigned tracker (ignored when a signed document is present):
# ENIGMA_LICENSE_ID=ENIGMA-DEV-001
# ENIGMA_LICENSE_CUSTOMER=Development Organization
# ENIGMA_LICENSE_START_DATE=2026-09-01
# ENIGMA_LICENSE_EXPIRATION_DATE=2027-09-01
# ENIGMA_LICENSE_DEPLOYMENT_TYPE=vpc

# Optional TLS reverse proxy notes: see docs/INSTALL.md
