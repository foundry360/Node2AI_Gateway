{
  "name": "@node2ai/gateway",
  "version": "0.1.0-ship",
  "private": true,
  "description": "Node2AI AI Governance Gateway — policy enforcement layer",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
